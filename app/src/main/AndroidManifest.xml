<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================= 권한 ================= -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- GitHub에서 받은 서명 APK를 시스템 업데이트 화면으로 넘긴다. 최종 설치 승인은 사용자가 한다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 오버레이 (M3 에서 활성화) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 포그라운드 서비스 (M1 에서 활성화) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 명시적으로 요청/사용하지 않는 것들 (감사용 주석):
         - 광고 ID (ACCESS_ADSERVICES_*)
         - 위치 (ACCESS_*_LOCATION)
         - 카메라/마이크
         - 전화 상태 (READ_PHONE_STATE)
         이들은 절대 선언하지 않는다 (보안 원칙 3). -->

    <!-- 다른 앱 패키지 조회 (Android 11+) — 게임 설치 감지용 -->
    <queries>
        <package android:name="com.xindong.torchlight" />
        <package android:name="com.xd.TLglobal" />
        <package android:name="com.xd.TLglobalTap" />
    </queries>

    <application
        android:name=".TrackerApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_mttd_launcher"
        android:roundIcon="@mipmap/ic_mttd_launcher_round"
        android:theme="@style/Theme.mTTD"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        tools:targetApi="34"
        xmlns:tools="http://schemas.android.com/tools">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- 진단 로그 공유(카카오톡 등) 시 cacheDir 파일을 content:// URI 로 노출 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          DirectDaemonStarter(app_process 로 shell UID 백그라운드 프로세스로 뜬 쪽)가 만든
          UserService 의 Binder 를 앱 프로세스로 넘겨받는 창구. exported 라야 shell UID 호출자가
          닿을 수 있다 — call() 안에서 호출자 UID 를 2000(shell)으로 제한해 임의 앱의 가짜 Binder
          주입을 막는다(DirectUserServiceProvider 참조).
        -->
        <provider
            android:name=".data.adb.starter.DirectUserServiceProvider"
            android:authorities="${applicationId}.direct.userservice"
            android:exported="true" />

        <!--
          페어링 코드 입력 알림(RemoteInput) 전용 — 설정 앱의 "페어링 코드로 기기 페어링"
          화면을 유저가 벗어나면 그 페어링 세션 자체가 끊기므로, 화면 전환 없이 알림 서랍에서
          코드를 받아야 한다. shortService: 짧게 끝나는 작업이라 추가 FGS 권한이 필요 없다.
        -->
        <service
            android:name=".service.DirectAdbPairingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <service
            android:name=".service.TrackerForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="screenSize|orientation|keyboardHidden|screenLayout|smallestScreenSize|density|uiMode"
            android:theme="@style/Theme.mTTD">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
