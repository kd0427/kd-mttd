<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose 팔레트(ui/theme/Theme.kt)가 라이트 고정이므로 XML 창 테마도 같은 방향으로 맞춘다.
      셋 중 하나라도 어긋나면 화면이 깨진다:
        - 부모가 다크 테마면 windowBackground 가 어두워서, 콜드 스타트에 검은 화면이 번쩍인 뒤
          Compose 첫 프레임에서 흰색으로 바뀐다.
        - windowLight*Bar 가 false 면 흰 배경 위에 흰 시스템 바 아이콘이 얹힌다.
      windowBackground 는 Theme.kt 의 background(#F7F9FC) 와 같은 값이어야 번쩍임이 없다.
    -->
    <style name="Theme.mTTD" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F9FC</item>
        <!-- enableEdgeToEdge() 가 콘텐츠를 시스템 바 뒤까지 그리므로 바 배경은 투명으로 둔다. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
